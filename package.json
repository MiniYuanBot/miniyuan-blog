{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "miniyuan-blog",
  "type": "module",
  "version": "0.1.2",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/plantuml-cache.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "plantuml": "node scripts/plantuml-cache.mjs",
    "check:assets": "node scripts/check-asset-links.mjs",
    "check:math": "node scripts/check-math.mjs",
    "check:hover": "node scripts/check-hover-gating.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^6.3.0",
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/rss": "^4.0.15",
    "astro": "^5.18.0",
    "katex": "^0.16.38",
    "plantuml-encoder": "^1.4.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.5",
    "shiki": "3.23.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.0",
    "@types/mdx": "^2.0.13",
    "@unocss/astro": "^66.6.6",
    "@unocss/preset-typography": "^66.6.0",
    "@unocss/preset-wind3": "^66.6.0",
    "@unocss/reset": "^66.6.0",
    "@unocss/transformer-directives": "^66.6.0",
    "unocss": "^66.6.0"
  },
  "pnpm": {
    "overrides": {
      "astro": "$astro"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "astro": ">=5.18.0 <6.0.0"
      }
    }
  }
}