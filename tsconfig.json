{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "astro.config.mjs"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ],
  "compilerOptions": {
    "types": ["astro/client"],
    "strictNullChecks": true,
    // Path aliases
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  }
}