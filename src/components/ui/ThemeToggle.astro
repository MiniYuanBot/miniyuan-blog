---
import { Icon } from "../ui";
---

<!--
  Note: no `id` here. <Header> renders this component twice (desktop nav and the
  mobile menu), and duplicate ids in one document are invalid — and would make
  `document.getElementById` ambiguous.
-->
<theme-toggle>
    <button
        type="button"
        class="theme-toggle-btn group/theme icon-button-base"
        aria-label="Toggle theme"
        title="切换主题"
    >
        <Icon class="system" name="computer" />
        <Icon class="light" name="sun" />
        <Icon class="dark" name="moon" />
    </button>
</theme-toggle>

<script>
    import { setTheme, getTheme, showToast } from "@/utils";

    class ThemeToggle extends HTMLElement {
        connectedCallback() {
            const btn = this.querySelector(
                ".theme-toggle-btn",
            ) as HTMLElement | null;
            if (!btn) return;

            const current = setTheme(getTheme() ?? undefined);
            btn.dataset.theme = current;
            btn.setAttribute(
                "aria-label",
                `Theme: ${current}. Click to switch.`,
            );

            btn.addEventListener("click", () => {
                const newTheme = setTheme(undefined, true);
                btn.dataset.theme = newTheme;
                btn.setAttribute(
                    "aria-label",
                    `Theme: ${newTheme}. Click to switch.`,
                );
                showToast({ message: `Set theme to ${newTheme}` });
            });
        }
    }

    customElements.define("theme-toggle", ThemeToggle);
</script>

<style>
    .theme-toggle-btn {
        & .system,
        & .light,
        & .dark {
            display: none;
        }

        &:not([data-theme]),
        &[data-theme="system"] {
            & .system {
                display: block;
            }
        }

        &[data-theme="light"] {
            & .light {
                display: block;
            }
        }

        &[data-theme="dark"] {
            & .dark {
                display: block;
            }
        }
    }
</style>
