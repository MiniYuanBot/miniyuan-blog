---
// Thin wrapper kept so existing imports (`@/components/ui` -> BlogCard) keep
// working; the markup lives in ContentCard.astro, shared with NoteCard.
import ContentCard, { type Props as ContentCardProps } from "./ContentCard.astro";

export type Props = Omit<ContentCardProps, "kind">;

const props = Astro.props;
---

<ContentCard {...props} kind="blog" />
