---
// Define a consistent html layout for blog posts.

import type { CollectionEntry } from "astro:content";
import { type MarkdownHeading } from "@astrojs/markdown-remark";
import BaseLayout from "./BaseLayout.astro";
import { FormattedDate } from "@/components/basic";
import { Card, Icon } from "@/components/ui";
import TOCList from "./TOCList.astro";

import "katex/dist/katex.min.css";

type Props = CollectionEntry<"blog">["data"] & { headings?: MarkdownHeading[] };

const {
	title,
	excerpt,
	author,
	tags,
	pubDate,
	updatedDate,
	heroImageLight,
	heroImageDark,
	headings = [],
} = Astro.props;
---

<BaseLayout title={title} description={excerpt}>
	<div slot="content">
		<Card
			hover={false}
			padding="lg"
			class="shadow-lg overflow-hidden max-w-none prose prose-md dark:prose-invert print-content"
		>
			<header class="print-header">
				<div
					class="flex flex-row items-center justify-start pt-2 gap-8 text-muted-foreground print-hidden"
				>
					<!-- Won't print -->
					<time
						class="inline-flex items-center gap-2 text-base font-mono"
						datetime={pubDate.toISOString()}
					>
						<Icon name="calendar" class="size-5" />
						<FormattedDate date={pubDate} />
					</time>

					{
						updatedDate && (
							<time
								class="inline-flex items-center gap-2 text-base font-mono"
								datetime={pubDate.toISOString()}
							>
								<Icon name="pencil" class="size-5" />
								<FormattedDate date={updatedDate} />
							</time>
						)
					}

					<div class="inline-flex items-center gap-2 text-base">
						<Icon name="user" class="size-5" />
						<span>{author}</span>
					</div>
				</div>

				<h1 class="mt-4 mb-0">
					{title}
				</h1>

				<hr class="my-6 md:my-8 border-t border-gray/20 print-hidden" />
			</header>

			<!-- Article content, use prose style atomatically -->
			<slot />
		</Card>
	</div>

	{
		!!headings.length && (
			<aside slot="sidebar">
				<TOCList {headings} />
			</aside>
		)
	}
</BaseLayout>

<style is:global>
	@media print {
		footer,
		nav,
		aside,
		.sidebar,
		.print-hidden {
			display: none !important;
		}

		body,
		main {
			background: white !important;
			padding: 0 !important;
			margin: 0 !important;
			max-width: 100% !important;
			min-height: auto !important;
		}

		[data-main-container] {
			display: block !important;
			width: 100% !important;
			max-width: 100% !important;
			flex: none !important;
		}

		.print-content {
			display: block !important;
			padding: 2rem !important;
			max-width: 100% !important;
			background: white !important;
			color: black !important;
			box-shadow: none !important;
			border: none !important;
		}

		.print-header h1 {
			font-size: 24pt !important;
			text-align: center !important;
			margin: 0 0 1rem 0 !important;
			color: black !important;
		}

		.prose,
		.prose p,
		.prose h2,
		.prose h3,
		.prose ul,
		.prose ol {
			color: black !important;
			display: block !important;
		}

		pre,
		code,
		pre[class*="language-"],
		code[class*="language-"] {
			white-space: pre-wrap !important;
			word-break: break-all !important;
			word-wrap: break-word !important;
			overflow: visible !important;
			max-width: 100% !important;
		}

		:not(pre) > code,
		pre {
			white-space: pre-wrap !important;
			word-break: break-all !important;
		}

		a {
			color: black !important;
			text-decoration: underline !important;
		}
	}
</style>
