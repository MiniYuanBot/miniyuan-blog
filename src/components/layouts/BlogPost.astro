---
// Define a consistent html layout for blog posts.

import type { PostData } from "@/schemas";
import { type MarkdownHeading } from "@astrojs/markdown-remark";
import BaseLayout from "./BaseLayout.astro";
import { FormattedDate } from "@/components/basic";
import { Card, Icon } from "@/components/ui";
import TOCList from "./TOCList.astro";

import "katex/dist/katex.min.css";

type Props = PostData & { headings?: MarkdownHeading[] };

const {
	title,
	excerpt,
	author,
	pubDate,
	updatedDate,
	headings = [],
} = Astro.props;
---

<BaseLayout title={title} description={excerpt}>
	<div slot="content">
		<Card
			hover={false}
			padding="lg"
			data-post-content
			class="shadow-lg overflow-hidden max-w-none prose dark:prose-invert print-content"
		>
			<header class="print-header">
				<div
					class="flex flex-wrap items-center gap-x-4 gap-y-2 pt-2 text-sm text-muted-foreground sm:gap-x-8 sm:text-base print-hidden"
				>
					<!-- Won't print -->
					<time
						class="inline-flex items-center gap-2 font-mono"
						datetime={pubDate.toISOString()}
					>
						<Icon name="calendar" class="size-5 shrink-0" />
						<FormattedDate date={pubDate} />
					</time>

					{
						updatedDate && (
							<time
								class="inline-flex items-center gap-2 font-mono"
								datetime={updatedDate.toISOString()}
							>
								<Icon name="pencil" class="size-5 shrink-0" />
								<FormattedDate date={updatedDate} />
							</time>
						)
					}

					{
						author && (
							<div class="inline-flex items-center gap-2">
								<Icon name="user" class="size-5 shrink-0" />
								<span>{author}</span>
							</div>
						)
					}
				</div>

				<h1 class="mt-4 mb-0">
					{title}
				</h1>

				<hr class="my-6 md:my-8 border-t border-gray/20 print-hidden" />
			</header>

			<!-- Article content, use prose style atomatically -->
			<slot />
		</Card>
	</div>

	{
		!!headings.length && (
			<aside slot="sidebar">
				<TOCList {headings} />
			</aside>
		)
	}
</BaseLayout>

<script>
	// Mermaid diagrams (```mermaid in Obsidian notes) are rendered in the
	// browser. The library is only downloaded on pages that contain one, and
	// diagrams are re-rendered when the theme toggles.
	const blocks = [...document.querySelectorAll<HTMLElement>("pre.mermaid")];
	if (blocks.length) {
		for (const block of blocks) block.dataset.source = block.textContent ?? "";

		const { default: mermaid } = await import("mermaid");
		const render = async () => {
			const dark = document.documentElement.classList.contains("dark");
			mermaid.initialize({ startOnLoad: false, theme: dark ? "dark" : "default" });
			for (const block of blocks) {
				block.removeAttribute("data-processed");
				block.textContent = block.dataset.source ?? "";
			}
			await mermaid.run({ nodes: blocks });
		};

		let dark = document.documentElement.classList.contains("dark");
		await render();
		new MutationObserver(() => {
			const now = document.documentElement.classList.contains("dark");
			if (now === dark) return;
			dark = now;
			render();
		}).observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["class"],
		});
	}
</script>

<style is:global>
	@media print {
		footer,
		nav,
		aside,
		.sidebar,
		.print-hidden {
			display: none !important;
		}

		body,
		main {
			background: white !important;
			padding: 0 !important;
			margin: 0 !important;
			max-width: 100% !important;
			min-height: auto !important;
		}

		[data-main-container] {
			display: block !important;
			width: 100% !important;
			max-width: 100% !important;
			flex: none !important;
		}

		.print-content {
			display: block !important;
			padding: 2rem !important;
			max-width: 100% !important;
			background: white !important;
			color: black !important;
			box-shadow: none !important;
			border: none !important;
		}

		.print-header h1 {
			font-size: 24pt !important;
			text-align: center !important;
			margin: 0 0 1rem 0 !important;
			color: black !important;
		}

		.prose,
		.prose p,
		.prose h2,
		.prose h3,
		.prose ul,
		.prose ol {
			color: black !important;
			display: block !important;
		}

		pre,
		code,
		pre[class*="language-"],
		code[class*="language-"] {
			white-space: pre-wrap !important;
			word-break: break-all !important;
			word-wrap: break-word !important;
			overflow: visible !important;
			max-width: 100% !important;
		}

		:not(pre) > code,
		pre {
			white-space: pre-wrap !important;
			word-break: break-all !important;
		}

		a {
			color: black !important;
			text-decoration: underline !important;
		}
	}
</style>
