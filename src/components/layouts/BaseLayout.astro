---
import { BaseHead, Header, Footer, ThemeProvider } from "../basic";
import { siteConfig } from "@/config";

interface Props {
	title: string;
	description: string;
	/** Path of the previous/next page, for paginated listings. */
	prev?: string;
	next?: string;
	noindex?: boolean;
	showSidebar?: boolean;
}

const { title, description, prev, next, noindex } = Astro.props;
const hasSidebar = Astro.props.showSidebar ?? Astro.slots.has("sidebar");
---

<!doctype html>
<html lang={siteConfig.lang}>
	<head>
		<BaseHead title={title} description={description} {prev} {next} {noindex} />
		<ThemeProvider />
	</head>
	<body class="flex flex-col bg-background text-foreground">
		<Header />
		<!--
			Padding is applied once, here. Previously `main` (px-6), the content
			column (mx-4) and every <Section> (px-4 + p-3) each added their own,
			which left roughly 250px of usable width on a 360px phone.
		-->
		<main
			class="w-full mx-auto max-w-[70rem] min-h-[100dvh] flex-1 px-4 py-6 sm:px-6 sm:py-8"
		>
			<div
				class:list={[
					"relative flex flex-col",
					hasSidebar &&
						"gap-6 md:flex-row md:items-start md:justify-center md:gap-8 lg:gap-12",
				]}
				data-main-container
			>
				{/* main content */}
				<div class="w-full min-w-0 flex-1">
					<slot name="content" />
				</div>

				{/* side bar – sticks to the top on desktop, flows after the content on mobile */}
				{
					hasSidebar && (
						<div class="w-full shrink-0 animate-fade-in md:sticky md:top-20 md:w-56 md:self-start lg:w-64">
							<slot name="sidebar" />
						</div>
					)
				}
			</div>
		</main>
		<Footer />
	</body>
</html>
