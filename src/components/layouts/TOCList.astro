---
import { type MarkdownHeading } from "@astrojs/markdown-remark";
import { Icon } from "../ui";

export interface Props {
  headings: MarkdownHeading[];
  maxDepth?: number;
  minDepth?: number;
  title?: string;
  class?: string;
}

const {
  headings,
  maxDepth = 4,
  minDepth = 2,
  title = "目录",
  class: className = "",
} = Astro.props;

const filteredHeadings = headings
  .filter((heading) => heading.depth <= maxDepth && heading.depth >= minDepth)
  .map((heading) => ({
    ...heading,
    id: heading.slug || heading.text.toLowerCase().replace(/\s+/g, "-"),
  }));

interface HeadingNode {
  depth: number;
  text: string;
  slug: string;
  children: HeadingNode[];
}

function buildHeadingTree(headings: MarkdownHeading[]): HeadingNode[] {
  const tree: HeadingNode[] = [];
  const stack: HeadingNode[] = [];

  headings.forEach((heading) => {
    const node: HeadingNode = {
      depth: heading.depth,
      text: heading.text,
      slug: heading.slug,
      children: [],
    };

    while (stack.length > 0 && stack[stack.length - 1].depth >= node.depth) {
      stack.pop();
    }

    if (stack.length === 0) {
      tree.push(node);
    } else {
      stack[stack.length - 1].children.push(node);
    }
    stack.push(node);
  });

  return tree;
}

const headingTree = buildHeadingTree(filteredHeadings);

const totalHeadings = headingTree.reduce((count, heading) => {
  const countChildren = (node: HeadingNode): number => {
    return (
      1 + node.children.reduce((sum, child) => sum + countChildren(child), 0)
    );
  };
  return count + countChildren(heading);
}, 0);
---

{
  headingTree.length > 0 && (
    <div class={`toc-wrapper ${className}`} data-total-headings={totalHeadings}>
      {/* open TOC button */}
      <button
        class="toc-trigger fixed right-6 top-1/5 translate-y-[-4rem] z-50 size-10 rounded-full shadow-md bg-gray-light hover:shadow-lg hover:bg-gray/40 transition-base flex items-center justify-center group"
        aria-label="open TOC"
        aria-expanded="false"
        aria-controls="toc-panel"
      >
        <Icon
          name="TOC"
          class="toc-icon-list size-6 text-foreground transition-base"
        />
        <Icon
          name="close"
          class="toc-icon-close size-6 absolute opacity-0 rotate-90 text-foreground transition-base"
        />
      </button>

      {/* TOC panel */}
      <div
        id="toc-panel"
        class="toc-panel fixed right-6 top-1/5 z-40 w-80 max-h-[70vh] rounded-xl shadow-2xl border border-border/50 opacity-0 transition-base overflow-hidden flex flex-col"
        style="background-color: var(--toc-bg); backdrop-filter: var(--toc-blur);"
        role="dialog"
        aria-modal="true"
        aria-label="blog TOC"
      >
        {/* panel head */}
        <div class="flex items-center justify-between px-4 py-3 border-b border-border/50 bg-transparent flex-shrink-0">
          <div class="flex items-center gap-2 text-sm font-semibold text-card-foreground">
            <Icon name="book" class="size-4" />
            <span>{title}</span>
          </div>

          {/* <div class="flex items-center gap-1">
            <button
              class="toc-close-btn p-1.5 rounded-md hover:bg-gray-light dark:hover:bg-gray-dark transition-colors text-muted-foreground hover:text-foreground"
              aria-label="close TOC"
            >
              <Icon name="close" class="size-4" />
            </button>
          </div> */}
        </div>

        {/* panel content */}
        <div class="toc-content overflow-y-auto p-3 bg-transparent scrollbar-thin scrollbar-thumb-muted-foreground/20 scrollbar-thumb-rounded-full hover:scrollbar-thumb-muted-foreground/40 flex-1">
          <nav aria-label="Table of contents">
            <ul class="space-y-0.5 text-sm">
              {headingTree.map((heading) => (
                <li class="toc-item">
                  <a
                    href={`#${heading.slug}`}
                    class="group block py-2 px-3 rounded-lg transition-base text-muted-foreground hover:text-foreground hover:bg-gray-light"
                    style={`padding-left: ${(heading.depth - 2) * 0.75 + 0.75}rem`}
                  >
                    <span class="line-clamp-2 relative">{heading.text}</span>
                  </a>

                  {heading.children && heading.children.length > 0 && (
                    <ul class="mt-0.5 space-y-0.5">
                      {heading.children.map((child) => (
                        <li class="toc-item">
                          <a
                            href={`#${child.slug}`}
                            class="group block py-2 px-3 rounded-lg transition-base text-muted-foreground hover:text-foreground hover:bg-gray-light"
                            style={`padding-left: ${(child.depth - 2) * 0.75 + 0.75}rem`}
                          >
                            <span class="line-clamp-2 relative">
                              {child.text}
                            </span>
                          </a>

                          {child.children && child.children.length > 0 && (
                            <ul class="mt-0.5 space-y-0.5">
                              {child.children.map((grandchild) => (
                                <li class="toc-item">
                                  <a
                                    href={`#${grandchild.slug}`}
                                    class="group block py-2 px-3 rounded-lg transition-base text-muted-foreground hover:text-foreground hover:bg-gray-light"
                                    style={`padding-left: ${(grandchild.depth - 2) * 0.75 + 0.75}rem`}
                                  >
                                    <span class="line-clamp-2 relative">
                                      {grandchild.text}
                                    </span>
                                  </a>
                                </li>
                              ))}
                            </ul>
                          )}
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </nav>
        </div>

        {/* panel bottom */}
        <div class="border-t border-border/50 p-1 bg-transparent flex-shrink-0">
          <button
            class="back-to-top w-full text-xs text-muted-foreground hover:text-foreground transition-colors flex items-center justify-center gap-1.5 py-2 rounded-lg hover:bg-gray-light"
            aria-label="go to top"
          >
            <Icon name="top-arrow" class="size-4" />
            <span>回到顶部</span>
          </button>
        </div>
      </div>

      {/* overlay */}
      {/* <div
        class="toc-overlay fixed inset-0 z-30 bg-background/20 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
        aria-hidden="true"
      /> */}
    </div>
  )
}

<style>
  .toc-item a.active {
    @apply bg-accent/10 text-accent border-l-accent font-medium;
  }

  .toc-item a.active .absolute {
    opacity: 1 !important;
    @apply bg-accent;
  }

  .toc-panel.open {
    @apply opacity-100;
    --toc-bg: hsl(var(--card) / 0.95);
    --toc-blur: blur(8px);
  }

  .toc-panel.open.is-scrolled {
    @apply opacity-100;
    --toc-bg: hsl(var(--card) / 0.8);
    --toc-blur: none;
  }

  /* overlay */
  /* .toc-overlay.open {
    @apply opacity-100 pointer-events-auto;
  } */

  .toc-trigger.active {
    @apply rotate-90;
  }

  .toc-trigger.active .toc-icon-list {
    @apply opacity-0;
  }

  .toc-trigger.active .toc-icon-close {
    @apply opacity-100 rotate-0;
  }

  /* smopth scroll */
  html {
    scroll-behavior: smooth;
  }

  @media print {
    .toc-wrapper {
      @apply hidden;
    }
  }

  @media (max-width: 640px) {
    .toc-panel {
      @apply right-4 left-4 w-auto bottom-20;
    }

    .toc-trigger {
      @apply right-4 bottom-4;
    }
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .toc-panel.open {
    animation: slideIn 0.2s ease-out;
  }

  .toc-content {
    scrollbar-width: thin;
    scrollbar-color: hsl(var(--muted-foreground) / 0.3) transparent;
  }

  .toc-content::-webkit-scrollbar {
    width: 4px;
  }

  .toc-content::-webkit-scrollbar-track {
    background: transparent;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const tocWrapper = document.querySelector(".toc-wrapper");
    if (!tocWrapper) return;

    const tocTrigger = tocWrapper.querySelector(".toc-trigger");
    const tocPanel = tocWrapper.querySelector(".toc-panel");
    const tocOverlay = tocWrapper.querySelector(".toc-overlay");
    const tocCloseBtn = tocWrapper.querySelector(".toc-close-btn");
    const tocLinks = tocWrapper.querySelectorAll(".toc-item a");
    const backToTopBtn = tocWrapper.querySelector(".back-to-top");
    const tocContent = tocWrapper.querySelector(".toc-content");

    const scrollThreshold = 200;
    const headerOffset = 100;

    let isOpen = false;
    let initialScrollY = window.scrollY;

    function preventScrollPropagation() {
      if (!tocContent) return;

      // Handle mouse scroll
      // Prevent the scroll event spread to the out page
      tocContent.addEventListener(
        "wheel",
        (e) => {
          const target = e.currentTarget as HTMLElement;
          const { scrollTop, scrollHeight, clientHeight } = target;

          const deltaY = (e as WheelEvent).deltaY;

          const isAtTop = scrollTop === 0;
          const isAtBottom =
            Math.abs(scrollHeight - clientHeight - scrollTop) < 1;

          if ((isAtTop && deltaY < 0) || (isAtBottom && deltaY > 0)) {
            e.preventDefault();
            e.stopPropagation();
          }
        },
        { passive: false },
      );

      let startY = 0;

      tocContent.addEventListener(
        "touchstart",
        (e) => {
          startY = (e as TouchEvent).touches[0].clientY;
        },
        { passive: true },
      );

      tocContent.addEventListener(
        "touchmove",
        (e) => {
          const touchEvent = e as TouchEvent;
          const target = e.currentTarget as HTMLElement;
          const currentY = touchEvent.touches[0].clientY;
          const deltaY = currentY - startY;

          const { scrollTop, scrollHeight, clientHeight } = target;
          const isAtTop = scrollTop === 0;
          const isAtBottom =
            Math.abs(scrollHeight - clientHeight - scrollTop) < 1;

          // Prevent the scroll event to be spread
          if ((isAtTop && deltaY > 0) || (isAtBottom && deltaY < 0)) {
            e.preventDefault();
            e.stopPropagation();
          }

          startY = currentY;
        },
        { passive: false },
      );
    }

    preventScrollPropagation();

    function updateScrollState() {
      if (Math.abs(window.scrollY - initialScrollY) > scrollThreshold) {
        tocPanel?.classList.add("is-scrolled");
      }
    }

    updateScrollState();

    window.addEventListener("scroll", updateScrollState, { passive: true });

    function toggleToc(show?: boolean) {
      if (typeof show === "undefined") {
        isOpen = !isOpen;
      } else {
        isOpen = show;
      }

      if (isOpen) {
        tocPanel?.classList.add("open");
        tocOverlay?.classList.add("open");
        tocTrigger?.classList.add("active");
        tocTrigger?.setAttribute("aria-expanded", "true");
        initialScrollY = window.scrollY;

        updateScrollState();
      } else {
        tocPanel?.classList.remove("open");
        tocOverlay?.classList.remove("open");
        tocTrigger?.classList.remove("active");
        tocTrigger?.setAttribute("aria-expanded", "false");
        tocPanel?.classList.remove("is-scrolled");
      }
    }

    tocTrigger?.addEventListener("click", () => toggleToc());
    tocCloseBtn?.addEventListener("click", () => toggleToc(false));
    tocOverlay?.addEventListener("click", () => toggleToc(false));

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen) {
        toggleToc(false);
      }
    });

    const headings = document.querySelectorAll("h2, h3, h4");
    headings.forEach((heading, index) => {
      if (!heading.id) {
        heading.id =
          heading.textContent
            ?.toLowerCase()
            .replace(/\s+/g, "-")
            .replace(/[^\w-]/g, "") || `heading-${index}`;
      }
    });

    const updateActiveHeading = () => {
      const scrollY = window.scrollY + headerOffset + 50;
      let active = null;

      for (let i = 0; i < headings.length; i++) {
        const heading = headings[i] as HTMLElement;
        const headingTop = heading.getBoundingClientRect().top + window.scrollY;
        if (scrollY >= headingTop) {
          active = heading;
        }
      }

      tocLinks.forEach((l) => l.classList.remove("active"));

      if (active) {
        const link = document.querySelector(
          `.toc-item a[href="#${active.id}"]`,
        );
        if (link) {
          link.classList.add("active");
          if (isOpen)
            link.scrollIntoView({ behavior: "smooth", block: "nearest" });
        }
      }
    };

    window.addEventListener("scroll", updateActiveHeading, { passive: true });
    updateActiveHeading();

    tocLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const targetId = link.getAttribute("href")?.substring(1);
        const targetElement = document.getElementById(targetId || "");

        if (targetElement) {
          const elementPosition = targetElement.getBoundingClientRect().top;
          const offsetPosition =
            elementPosition + window.pageYOffset - headerOffset;

          window.scrollTo({
            top: offsetPosition,
            behavior: "smooth",
          });

          history.pushState(null, "", `#${targetId}`);

          if (window.innerWidth < 640) {
            toggleToc(false);
          }
        }
      });
    });

    backToTopBtn?.addEventListener("click", () => {
      window.scrollTo({
        top: 0,
        behavior: "smooth",
      });
    });

    const checkInitialHash = () => {
      const hash = window.location.hash;
      if (hash) {
        const targetLink = document.querySelector(
          `.toc-item a[href="${hash}"]`,
        );
        if (targetLink) {
          setTimeout(() => {
            targetLink.classList.add("active");
          }, 100);
        }
      }
    };

    checkInitialHash();
  });
</script>
