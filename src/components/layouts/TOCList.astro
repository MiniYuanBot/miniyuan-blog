---
import { type MarkdownHeading } from "@astrojs/markdown-remark";
import { Icon } from "../ui";
import TOCItems from "./TOCItems.astro";

export interface Props {
  headings: MarkdownHeading[];
  maxDepth?: number;
  minDepth?: number;
  title?: string;
  class?: string;
}

const {
  headings,
  maxDepth = 4,
  minDepth = 2,
  title = "目录",
  class: className = "",
} = Astro.props;

// `heading.slug` is always set by rehypeHeadingIds; the fallback keeps this
// component usable if that ever changes.
const filteredHeadings = headings
  .filter((heading) => heading.depth <= maxDepth && heading.depth >= minDepth)
  .map((heading) => ({
    ...heading,
    slug: heading.slug || heading.text.toLowerCase().replace(/\s+/g, "-"),
  }));
---

{
  filteredHeadings.length > 0 && (
    <div class={`toc-wrapper ${className}`} data-toc-wrapper>
      {/* ---------- Desktop: a normal, always-visible card in the sidebar ---------- */}
      <div class="hidden md:block rounded-xl border border-border/50 bg-card/95 shadow-sm overflow-hidden">
        <div class="flex items-center gap-2 px-4 py-3 border-b border-border/50 text-sm font-semibold text-card-foreground">
          <Icon name="book" class="size-4" />
          <span>{title}</span>
        </div>
        <div class="toc-content max-h-[60vh] overflow-y-auto p-3 scrollbar-thin">
          <nav aria-label="Table of contents">
            <TOCItems headings={filteredHeadings} />
          </nav>
        </div>
        <div class="border-t border-border/50 p-1">
          <button
            type="button"
            class="back-to-top w-full text-xs text-muted-foreground hover:text-foreground transition-colors flex items-center justify-center gap-1.5 py-2 rounded-lg hover:bg-gray-light"
            aria-label="go to top"
          >
            <Icon name="top-arrow" class="size-4" />
            <span>回到顶部</span>
          </button>
        </div>
      </div>

      {/* ---------- Mobile: floating trigger + bottom sheet ---------- */}
      <button
        type="button"
        data-toc-trigger
        class="toc-trigger md:hidden fixed right-4 z-40 size-11 rounded-full shadow-lg bg-card/95 backdrop-blur border border-border/60 flex items-center justify-center transition-base active:scale-95"
        style="bottom: calc(1rem + var(--safe-bottom));"
        aria-label="打开目录"
        aria-expanded="false"
        aria-controls="toc-sheet"
      >
        <Icon name="TOC" class="size-5 text-foreground" />
      </button>

      {/* Sheet backdrop */}
      <div
        data-toc-backdrop
        class="toc-backdrop md:hidden fixed inset-0 z-40 bg-foreground/30 backdrop-blur-sm"
        aria-hidden="true"
      >
      </div>

      {/* Bottom sheet */}
      <div
        id="toc-sheet"
        data-toc-sheet
        class="toc-sheet md:hidden fixed inset-x-0 bottom-0 z-50 flex flex-col
               max-h-[75vh] rounded-t-2xl border-t border-border/60 bg-card shadow-2xl"
        role="dialog"
        aria-modal="true"
        aria-label={title}
      >
        <div class="flex items-center justify-between px-4 py-3 border-b border-border/50 shrink-0">
          <div class="flex items-center gap-2 text-sm font-semibold text-card-foreground">
            <Icon name="book" class="size-4" />
            <span>{title}</span>
          </div>
          <button
            type="button"
            data-toc-close
            class="size-9 -mr-1 rounded-lg flex items-center justify-center text-muted-foreground hover:text-foreground hover:bg-gray-light transition-colors"
            aria-label="关闭目录"
          >
            <Icon name="close" class="size-5" />
          </button>
        </div>

        <div class="toc-content flex-1 min-h-0 overflow-y-auto p-3 scrollbar-thin">
          <nav aria-label="Table of contents">
            <TOCItems headings={filteredHeadings} />
          </nav>
        </div>

        <div
          class="border-t border-border/50 p-1 shrink-0"
          style="padding-bottom: calc(0.25rem + var(--safe-bottom));"
        >
          <button
            type="button"
            class="back-to-top w-full text-xs text-muted-foreground hover:text-foreground transition-colors flex items-center justify-center gap-1.5 py-2.5 rounded-lg hover:bg-gray-light"
            aria-label="go to top"
          >
            <Icon name="top-arrow" class="size-4" />
            <span>回到顶部</span>
          </button>
        </div>
      </div>
    </div>
  )
}

<style>
  /* ---------- desktop card ---------- */
  .toc-link.is-active {
    @apply bg-accent/10 text-accent font-medium;
  }

  .toc-content {
    scrollbar-width: thin;
    scrollbar-color: hsl(var(--muted-foreground) / 0.3) transparent;
    -webkit-overflow-scrolling: touch;
  }

  .toc-content::-webkit-scrollbar {
    width: 4px;
  }

  .toc-content::-webkit-scrollbar-track {
    background: transparent;
  }

  /* ---------- mobile sheet ---------- */
  .toc-backdrop {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.2s ease-out,
      visibility 0.2s;
  }

  .toc-sheet {
    transform: translateY(100%);
    visibility: hidden;
    transition:
      transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0.25s;
  }

  .toc-wrapper.is-open .toc-backdrop {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .toc-wrapper.is-open .toc-sheet {
    transform: translateY(0);
    visibility: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-backdrop,
    .toc-sheet {
      transition: none;
    }
  }

  @media print {
    .toc-wrapper {
      display: none;
    }
  }
</style>

<script>
  /**
   * Table of contents.
   *
   * The active heading is tracked with an IntersectionObserver instead of a
   * scroll listener that read layout on every frame, and anchor navigation is
   * left to the browser (`scroll-behavior` + `scroll-padding-top` in
   * global.css), which removes all the manual offset maths.
   */
  function initToc() {
    const wrapper = document.querySelector<HTMLElement>("[data-toc-wrapper]");
    const article = document.querySelector<HTMLElement>("[data-post-content]");
    if (!wrapper || !article) return;

    const trigger = wrapper.querySelector<HTMLElement>("[data-toc-trigger]");
    const sheet = wrapper.querySelector<HTMLElement>("[data-toc-sheet]");
    const backdrop = wrapper.querySelector<HTMLElement>("[data-toc-backdrop]");
    const closeBtn = wrapper.querySelector<HTMLElement>("[data-toc-close]");
    const links = Array.from(
      wrapper.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"),
    );

    // ---------------------------------------------------------------- panel
    let isOpen = false;

    const setOpen = (open: boolean) => {
      if (open === isOpen) return;
      isOpen = open;
      wrapper.classList.toggle("is-open", open);
      trigger?.setAttribute("aria-expanded", String(open));
      // Lock the page behind the sheet; the sheet scrolls on its own.
      document.documentElement.style.overflow = open ? "hidden" : "";
      if (open) {
        sheet
          ?.querySelector<HTMLElement>("[data-toc-link], [data-toc-close]")
          ?.focus({ preventScroll: true });
      } else if (sheet?.contains(document.activeElement)) {
        trigger?.focus({ preventScroll: true });
      }
    };

    trigger?.addEventListener("click", () => setOpen(true));
    backdrop?.addEventListener("click", () => setOpen(false));
    closeBtn?.addEventListener("click", () => setOpen(false));

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isOpen) setOpen(false);
    });

    // ------------------------------------------------------- active heading
    const headings = Array.from(
      article.querySelectorAll<HTMLElement>("h2, h3, h4"),
    ).filter((heading) => heading.id);

    const linksBySlug = new Map<string, HTMLAnchorElement>();
    for (const link of links) {
      const slug = link.dataset.slug;
      if (slug) linksBySlug.set(decodeURIComponent(slug), link);
    }

    let activeSlug: string | null = null;

    const setActive = (slug: string | null) => {
      if (slug === activeSlug) return;
      activeSlug = slug;
      for (const [key, link] of linksBySlug) {
        link.classList.toggle("is-active", key === slug);
      }
      // Keep the highlighted entry in view inside the scrolling list, without
      // fighting the page scroll.
      if (slug) {
        linksBySlug.get(slug)?.scrollIntoView({ block: "nearest" });
      }
    };

    const headerOffset = parseFloat(
      getComputedStyle(document.documentElement).getPropertyValue(
        "--header-height",
      ),
    );
    const topOffset = Number.isFinite(headerOffset) ? headerOffset * 16 : 64;

    if (headings.length && "IntersectionObserver" in window) {
      const visible = new Set<HTMLElement>();

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const heading = entry.target as HTMLElement;
            if (entry.isIntersecting) visible.add(heading);
            else visible.delete(heading);
          }

          if (visible.size) {
            // Topmost heading currently inside the band under the header.
            const first = Array.from(visible).sort(
              (a, b) =>
                a.getBoundingClientRect().top - b.getBoundingClientRect().top,
            )[0];
            setActive(first.id);
            return;
          }

          // Between headings: highlight the last one already scrolled past.
          let last: HTMLElement | null = null;
          for (const heading of headings) {
            if (heading.getBoundingClientRect().top - topOffset <= 1) last = heading;
          }
          if (last) setActive(last.id);
        },
        {
          rootMargin: `-${topOffset + 8}px 0px -65% 0px`,
          threshold: 0,
        },
      );

      for (const heading of headings) observer.observe(heading);
    }

    // Clicking a link inside the sheet closes it; the browser handles the jump.
    for (const link of links) {
      link.addEventListener("click", () => setOpen(false));
    }

    // A resize into desktop layout must not leave the sheet state behind.
    window.matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });

    for (const btn of wrapper.querySelectorAll(".back-to-top")) {
      btn.addEventListener("click", () => {
        setOpen(false);
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    }

    // Highlight the heading named in the URL, if any.
    if (window.location.hash) {
      setActive(decodeURIComponent(window.location.hash.slice(1)));
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initToc, { once: true });
  } else {
    initToc();
  }
</script>
