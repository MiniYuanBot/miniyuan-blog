---
import { BaseLayout, Section } from "@/components/layouts";
import { Card, Icon } from "@/components/ui";
import LinkCard from "@/components/ui/LinkCard.astro";
import { linkConfig, siteConfig } from "@/config";
---

<BaseLayout title="Links" description="My friends and favorite tools">
    <!-- Link Groups -->
    <div slot="content">
        {
            linkConfig.map((group, index) => (
                <Section title={group.title} level={index === 0 ? 1 : 2}>
                    {group.links.length > 0 ? (
                        <div class="grid grid-cols-1 gap-3 sm:gap-4 md:grid-cols-2 lg:grid-cols-3">
                            {group.links.map((link) => (
                                <LinkCard
                                    title={link.title}
                                    description={link.description}
                                    url={link.url}
                                    avatar={link.avatar}
                                />
                            ))}
                        </div>
                    ) : (
                        <Card padding="lg" class="text-center py-16">
                            <Icon
                                name="empty"
                                class="size-8 mx-auto mb-4 text-muted-foreground"
                            />
                            <p class="text-lg text-muted-foreground">
                                No links
                            </p>
                        </Card>
                    )}
                </Section>
            ))
        }

        <!-- Add Link Section -->
        <Section title="Apply for a Friend Link">
            <p class="text-base text-muted-foreground mb-4">
                Would you like to exchange friend links? Please contact me with
                the following information:
            </p>
            <Card padding="lg" hover={false}>
                <dl class="flex flex-col gap-3 sm:grid sm:grid-cols-2">
                    <!-- Site Name -->
                    <div class="flex gap-3 items-baseline">
                        <dt class="text-base text-foreground w-24 shrink-0">Site Name</dt>
                        <dd class="m-0 text-sm text-muted-foreground break-all">
                            {siteConfig.title}
                        </dd>
                    </div>

                    <!-- Favicon -->
                    <div class="flex gap-3 items-baseline">
                        <dt class="text-base text-foreground w-24 shrink-0">Favicon</dt>
                        <dd class="m-0 text-sm text-muted-foreground break-all">
                            {siteConfig.url}{siteConfig.favicon}
                        </dd>
                    </div>

                    <!-- Description -->
                    <div class="flex gap-3 items-baseline">
                        <dt class="text-base text-foreground w-24 shrink-0">Description</dt>
                        <dd class="m-0 text-sm text-muted-foreground break-all">
                            {siteConfig.description}
                        </dd>
                    </div>

                    <!-- URL -->
                    <div class="flex gap-3 items-baseline">
                        <dt class="text-base text-foreground w-24 shrink-0">URL</dt>
                        <dd class="m-0 text-sm break-all">
                            <a
                                href={siteConfig.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center gap-1 text-accent no-underline hover:underline"
                            >
                                {siteConfig.url}
                                <Icon name="external" class="size-3" />
                            </a>
                        </dd>
                    </div>
                </dl>
            </Card>
        </Section>
    </div>
</BaseLayout>
