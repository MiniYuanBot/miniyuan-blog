---
import { getCollection } from "astro:content";
import ListingPage from "@/components/layouts/ListingPage.astro";
import { siteConfig } from "@/config";
import { laterPageParams } from "@/utils/pagination";

export async function getStaticPaths() {
    const notes = await getCollection("note");
    return laterPageParams(notes.length, siteConfig.postsPerPage);
}

const { page } = Astro.props;
---

<ListingPage kind="note" {page} />
